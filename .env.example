# Floorline — environment configuration
# Copy to .env.local for local development; set these in the hosting provider
# for production. NEVER commit real secrets.

# ─── NEAR ────────────────────────────────────────────────────────────────
# JSON-RPC endpoint for on-chain reads (mainnet public node by default)
NEAR_RPC_URL=https://rpc.mainnet.near.org  # testnet: https://near-testnet.drpc.org
# The deployed vault contract. Reads fail honestly until it is deployed.
VAULT_CONTRACT_ID=floorline-demo.near

# ─── NEAR Intents / 1Click ───────────────────────────────────────────────
# Partner API key from https://partners.near-intents.org — REQUIRED for the
# real reusable-deposit-address flow. Without it, /api/deposit returns the
# upstream rejection plus the remediation.
ONE_CLICK_API_KEY=
# Optional JWT from partners.near-intents.org: enables confidential intents
# and removes the 0.25% unauthenticated fee.
INTENTS_JWT=

# ─── NEAR AI Cloud (TEE attestation, modular) ────────────────────────────
# Without these, /api/v1/attestation/:id reports verified:false honestly.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8

# ─── Persistence ─────────────────────────────────────────────────────────
# Durable deposit tracking store (JSON file). Point at a mounted volume in
# production; single-instance by default.
DEPOSITS_STORE_PATH=.data/deposits.json

# ── Database ──────────────────────────────────────────────────────────────
# Postgres 16 or Supabase. The stores auto-migrate on first use.
# Local docker:      postgres://floorline:floorline@localhost:5432/floorline
# Supabase (paste the "Connection pooling" URI from Settings → Database):
#   1. Create the project at supabase.com
#   2. Copy the connection string into DATABASE_URL below (or in .env.local)
#   3. Restart the app — the deposit + policy stores point at Supabase
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
